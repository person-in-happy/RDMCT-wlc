\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces 8片实例的最优排程甘特图。三行分别对应纯$4\times 1$、纯$2\times 2$和4:4混跑，左、右列分别给出晶圆视角与资源视角。横轴为时间（s）；颜色依次表示搬运、AL对准、装载锁操作、腔室装卸片、腔室加工、回片/下游处理以及等待/占位。三种模式的$C_{\max }$分别为610、768和834~s，对应等效吞吐率为47.21、37.50和34.53片/h。}}{10}{figure.4}\protected@file@percent }
\newlabel{fig:gantt8-zh}{{4}{10}{8片实例的最优排程甘特图。三行分别对应纯$4\times 1$、纯$2\times 2$和4:4混跑，左、右列分别给出晶圆视角与资源视角。横轴为时间（s）；颜色依次表示搬运、AL对准、装载锁操作、腔室装卸片、腔室加工、回片/下游处理以及等待/占位。三种模式的$C_{\max }$分别为610、768和834~s，对应等效吞吐率为47.21、37.50和34.53片/h。}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces 16片实例的最优排程甘特图。三行分别对应纯$4\times 1$、纯$2\times 2$和8:8混跑，左、右列分别给出晶圆视角与资源视角。横轴为时间（s）；颜色含义与图~\ref {fig:gantt8-zh}一致。三种模式的$C_{\max }$分别为944、1136和1170~s，对应等效吞吐率为61.02、50.70和49.23片/h。}}{10}{figure.5}\protected@file@percent }
\newlabel{fig:gantt16-zh}{{5}{10}{16片实例的最优排程甘特图。三行分别对应纯$4\times 1$、纯$2\times 2$和8:8混跑，左、右列分别给出晶圆视角与资源视角。横轴为时间（s）；颜色含义与图~\ref {fig:gantt8-zh}一致。三种模式的$C_{\max }$分别为944、1136和1170~s，对应等效吞吐率为61.02、50.70和49.23片/h。}{figure.5}{}}
