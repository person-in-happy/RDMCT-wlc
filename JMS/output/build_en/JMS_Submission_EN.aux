\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces $2\times 2$ chained processing. A PW pair may be P+P, D+D, or P+D; here each P$i$ is a P+P product PW pair and D is a D+D dummy PW pair. Step 1 loads D, rotates the chamber, and loads P1; Step 2 processes and rotates D+P1; Step 3 slides the chain to P1+P2. Subsequent slide--process events make P1, P2, and P3 participate in two adjacent process cycles, so every product wafer is processed twice before all wafers are unloaded.}}{3}{}\protected@file@percent }
\newlabel{fig:chain-en}{{2}{3}{}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces $4\times 1$ parallel processing. A regular all-product batch uses two product PW pairs, comprising four product wafers, and receives one synchronous full-occupancy process before last-in--first-out unloading; a dummy or mixed PW pair can complete the final short batch.}}{3}{}\protected@file@percent }
