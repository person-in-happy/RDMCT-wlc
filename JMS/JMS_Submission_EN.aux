\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Optimal schedules for the 8-wafer instance. Rows represent pure $4\times 1$, pure $2\times 2$, and 4:4 mixed operation; the left and right columns give wafer-level and resource-level views. The horizontal axis is time (s), and colors distinguish transport, AL alignment, load-lock operations, chamber loading/unloading, chamber processing, return/downstream handling, and waiting/occupancy. The three $C_{\max }$ values are 610, 768, and 834~s, corresponding to equivalent throughputs of 47.21, 37.50, and 34.53 wafers/h.}}{12}{figure.4}\protected@file@percent }
\newlabel{fig:gantt8-en}{{4}{12}{Optimal schedules for the 8-wafer instance. Rows represent pure $4\times 1$, pure $2\times 2$, and 4:4 mixed operation; the left and right columns give wafer-level and resource-level views. The horizontal axis is time (s), and colors distinguish transport, AL alignment, load-lock operations, chamber loading/unloading, chamber processing, return/downstream handling, and waiting/occupancy. The three $C_{\max }$ values are 610, 768, and 834~s, corresponding to equivalent throughputs of 47.21, 37.50, and 34.53 wafers/h}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Optimal schedules for the 16-wafer instance. Rows represent pure $4\times 1$, pure $2\times 2$, and 8:8 mixed operation; the left and right columns give wafer-level and resource-level views. The horizontal axis is time (s), with colors defined as in Fig.~\ref {fig:gantt8-en}. The three $C_{\max }$ values are 944, 1136, and 1170~s, corresponding to equivalent throughputs of 61.02, 50.70, and 49.23 wafers/h.}}{12}{figure.5}\protected@file@percent }
\newlabel{fig:gantt16-en}{{5}{12}{Optimal schedules for the 16-wafer instance. Rows represent pure $4\times 1$, pure $2\times 2$, and 8:8 mixed operation; the left and right columns give wafer-level and resource-level views. The horizontal axis is time (s), with colors defined as in Fig.~\ref {fig:gantt8-en}. The three $C_{\max }$ values are 944, 1136, and 1170~s, corresponding to equivalent throughputs of 61.02, 50.70, and 49.23 wafers/h}{figure.5}{}}
