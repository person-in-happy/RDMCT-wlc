{
  "schema_version": "rl_sat_config_v1",
  "tool": {
    "num_pm": 2,
    "num_steps": 13,
    "process_mode": "mixed",
    "mode_4x1_wafers": 10,
    "mode_2x2_wafers": 10,
    "mode_sequence": [],
    "pec_pool_size": 8,
    "pec_storage_slots": 10,
    "batch_size": 4,
    "pm_rotation_time_180": 2.0,
    "pair_transfer_time": 4.0,
    "atr_transfer_time": 3.0,
    "atr_return_time": 3.0,
    "aligner_time": 20.0,
    "llupper_time": 30.0,
    "lllower_time": 25.0,
    "full_process_time": 180.0,
    "mix_boundary_process_time": 180.0,
    "mix_internal_process_time": 180.0,
    "cleaning_interval": 5,
