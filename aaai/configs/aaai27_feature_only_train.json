{
  "experiment": {
    "seed": 1,
    "exp_prefix": "aaai27_rdmct_role23_feature_only",
    "base_log_dir": "aaai/models/final_ablation/feature_only",
    "snapshot_mode": "gap_and_last",
    "snapshot_gap": 5,
    "compact_text_log": true,
    "text_log_max_mb": 8,
    "text_log_backup_count": 2
  },
  "env": {
    "instance_file_path": "aaai/data/petri_submodular/train",
    "scip_time_limit": 30,
    "scip_memory_limit_mb": 1024,
    "scip_heuristics_profile": "fast",
    "scip_disable_expensive_heuristics": true,
    "single_instance_file": "all",
    "presolving": true,
    "separating": true,
    "conflict": true,
    "heuristics": true,
    "max_rounds_root": 1,
    "lexicographic_schedule_stability": false,
    "cutsel_max_candidates": 128,
    "cutsel_max_selected_cuts": 16,
    "cutsel_use_structure_rerank": false
  },
  "algorithm": {
    "evaluate_freq": 0,
    "evaluate_samples": 16,
    "optimizer_class": "Adam",
    "actor_net_lr": 0.0001,
    "critic_net_lr": 0.0001,
    "reward_scale": 1,
    "num_epochs": 60,
    "max_grad_norm": 2.0,
    "batch_size": 8,
    "train_decode_type": "stochastic",
    "evaluate_decode_type": "greedy",
    "reward_type": "primaldualintegral",
    "baseline_type": "simple",
    "critic_beta": 0.9,
    "train_steps_per_epoch": 4,
    "lr_decay": true,
    "lr_decay_step": 10,
    "lr_decay_rate": 0.96,
    "normalize": false,
    "normalize_reward": false
  },
  "trainer": {
    "samples_per_epoch": 8,
    "n_jobs": 2,
    "worker_stall_grace_seconds": 30,
    "worker_restart_limit": 2
  },
  "net_share": {
    "embedding_dim": 23,
    "hidden_dim": 128,
    "tanh_exploration": 5,
    "use_tanh": true
  },
  "policy": {
    "n_glimpses": 1,
    "beam_size": 3
  },
  "value": {
    "n_process_block_iters": 3
  },
  "cutsel_percent_policy": {
    "use_cutsel_percent_policy": true,
    "train_freq": 2,
    "train_highlevel_batch_size": 16,
    "highlevel_actor_lr": 0.0005
  },
  "devices": {
    "global_device": "cuda:0",
    "multi_devices": ["cuda:0"]
  },
  "test_kwargs": {
    "test_instance_path": "aaai/data/petri_submodular/test",
    "test_model_path": "aaai/models/final_ablation/feature_only/params.pkl",
    "n_jobs": 1
  },
  "online_test_kwargs": {
    "test_freq": 0,
    "test_instance_path": "aaai/data/petri_submodular/test",
    "test_n_jobs": 1,
    "test_env_kwargs": {
      "scip_time_limit": 60,
      "scip_memory_limit_mb": 1024,
      "scip_heuristics_profile": "fast",
      "scip_disable_expensive_heuristics": true,
      "single_instance_file": "all",
      "presolving": true,
      "separating": true,
      "conflict": true,
      "heuristics": true,
      "max_rounds_root": 1,
      "lexicographic_schedule_stability": false,
      "cutsel_use_structure_rerank": false
    }
  },
  "start_epoch": 0
}
